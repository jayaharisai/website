# Template for .env. Copy it to .env and fill in the values. Safe to commit (no secrets).

# --- Notion ---------------------------------------------------------------------
# Server-side only: never prefix these with NEXT_PUBLIC_.
# Where to find them: see "Notion" in README.md.
NOTION_API_KEY=

# One database per section. Paste the 32-character ID from each database's link.
NOTION_PROJECTS_DATABASE_ID=
NOTION_POSTS_DATABASE_ID=
NOTION_NOTES_DATABASE_ID=

# --- Instant refresh ---------------------------------------------------------------
# Any long random string. Opening /api/revalidate?secret=THIS_VALUE refreshes your Notion
# content immediately (otherwise the live site picks up edits within about a minute).
REVALIDATE_SECRET=

# --- Supabase (optional: not used yet) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
